# Server
PORT=8080

# Postgres
DATABASE_URL=postgres://user:password@localhost:5432/url_shortener

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this

# S3 (private bucket; access via presigned URLs)
S3_BUCKET=chloride
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# Optional: for S3-compatible providers (R2, MinIO, Spaces)
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# Optional: presigned URL lifetime in seconds (default 7 days)
# S3_PRESIGN_EXPIRES_IN=604800

# Domain used to build shortened URLs
DOMAIN=localhost:8080
